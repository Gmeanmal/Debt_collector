# App environment: dev | test | staging | prod
# Prod auto-enables: Secure cookies, SameSite=strict, HSTS header.
APP_ENV=dev

DATABASE_URL=postgresql+asyncpg://debt:debt@localhost:4012/debt

# SECURITY: regenerate a long random string in prod (e.g. `openssl rand -hex 32`)
JWT_SECRET_KEY=replace-me-with-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30
PASSWORD_RESET_TTL_MINUTES=60
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=4
CORS_ORIGINS=http://localhost:4010,http://127.0.0.1:4010
# Optional regex for tunneled frontends. Used alongside CORS_ORIGINS when set.
# Example: ^https://[a-z0-9-]+\.(ngrok-free\.app|trycloudflare\.com)$
CORS_ORIGIN_REGEX=
# Cookie attribute overrides (for cross-site tunnel testing).
# Set SAMESITE=none + SECURE=true when front and back are on different https tunnels.
REFRESH_COOKIE_SAMESITE_OVERRIDE=
REFRESH_COOKIE_SECURE_OVERRIDE=

# Refresh cookie. Secure/SameSite are derived from APP_ENV; override only name/domain.
REFRESH_COOKIE_NAME=debt_refresh
REFRESH_COOKIE_DOMAIN=

# Rate limits (slowapi syntax: "<count>/<period>")
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_SIGNUP=5/minute
RATE_LIMIT_PASSWORD_RESET=3/minute
RATE_LIMIT_PUBLIC_INVITATION=30/minute

# Rate-limiter storage backend: "memory" (default, dev/test) or "redis" (staging/prod).
# When set to "redis", REDIS_URL must also be provided.
RATE_LIMITER_BACKEND=memory
REDIS_URL=

# Email — set EMAIL_DRIVER=resend and provide RESEND_API_KEY for production
EMAIL_DRIVER=smtp
MAIL_FROM=Goddess Mean Mal <no-reply@localhost>
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@debt-collector.local
SMTP_HOST=localhost
SMTP_PORT=4013
PUBLIC_BASE_URL=http://localhost:4010

APP_URL=http://localhost:4010
APP_TIMEZONE=Europe/London

# Password pepper: secret HMAC key applied before argon2 hashing (defense-in-depth).
# A DB leak alone won't enable offline cracking without this key.
# Must differ from JWT_SECRET_KEY. Rotate separately. Empty = disabled (legacy mode).
PASSWORD_PEPPER=

# Admin + goddess bootstrap lives in seeds/bootstrap.py (dev fake data, not secrets).
# For prod, onboard via a one-off admin-creation script — not via env vars.

# ---- Cloudflare R2 (§16.2 sub photos, §21 toys, §22 vault) ----
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_SUB_PHOTOS=
R2_BUCKET_TOYS=
R2_BUCKET_VAULT=
R2_PRESIGN_TTL_SECONDS=600

# ---- Crypto envelope (§25.1) ----
# Root KEK: base64 32 bytes (openssl rand -base64 32). Rotates independently of JWT.
ROOT_KEK_B64=
ROOT_KEK_VERSION=1
